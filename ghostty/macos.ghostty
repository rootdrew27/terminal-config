# macOS-only Ghostty settings. Selected as platform.ghostty by install.sh.

macos-titlebar-style = tabs
# Left Option sends Alt (for alt+b/alt+f word jumps); right Option still types special chars
macos-option-as-alt = left
window-save-state = always

# Quick terminal toggle. global: works when Ghostty isn't focused, but macOS will ask for Accessibility permission
keybind = global:cmd+grave_accent=toggle_quick_terminal
