# Shared Ghostty config (macOS + Linux). See all options: ghostty +show-config --default --docs
# Reload with cmd+shift+, (macOS) or ctrl+shift+, (Linux).
# OS-specific settings live in macos.ghostty / linux.ghostty; install.sh links the
# right one as platform.ghostty next to this file (and as a gitignored link in the repo).

# --- Appearance ---
# Follows the system light/dark mode. Browse others: ghostty +list-themes
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
# JetBrains Mono is bundled, and Nerd Font icons are built in, so starship glyphs work without a patched font.
font-size = 14
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
# Dim inactive splits so the focused one is obvious
unfocused-split-opacity = 0.85
background-opacity = 0.92
# Blur is honoured on macOS and KDE; other Linux desktops ignore it
background-blur = true
cursor-style = block
cursor-style-blink = false

# --- Behavior ---
mouse-hide-while-typing = true
copy-on-select = clipboard
# Scrollback is measured in bytes, so this is about 100 MB per surface
scrollback-limit = 100000000
# Copy Ghostty's terminfo to SSH hosts and fall back to xterm-256color, so remote shells don't fail with "unknown terminal type"
# no-cursor: stop shell integration from switching the cursor to a bar at the prompt
shell-integration-features = no-cursor,ssh-terminfo,ssh-env

# --- Quick terminal (drop-down) ---
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# --- Per-OS settings (the "?" makes a missing file a no-op) ---
config-file = ?platform.ghostty
